# The demo runs without an API key. Switch to `openai` for a real model.
MODEL_PROVIDER=mock
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_MAX_CALLS=12
MODEL_REQUEST_TIMEOUT_SECONDS=90
MODEL_MAX_RATE_LIMIT_RETRIES=2
MODEL_MAX_TRANSIENT_RETRIES=2
MODEL_RETRY_BASE_SECONDS=1
MODEL_MAX_RETRY_WAIT_SECONDS=30
MODEL_MAX_TOTAL_BACKOFF_SECONDS=60
# Zero disables the trusted provider-token ceiling. Call/output limits still apply.
MODEL_MAX_TOTAL_TOKENS=0
MODEL_MAX_OUTPUT_TOKENS=4096

DATABASE_URL=postgresql+asyncpg://repopilot:repopilot@postgres:5432/repopilot
LANGGRAPH_DATABASE_URL=postgresql://repopilot:repopilot@postgres:5432/repopilot?sslmode=disable
REDIS_URL=redis://redis:6379/0

API_KEY=
WORKSPACE_ROOT=/workspaces
MAX_CONTEXT_FILES=12
MAX_CONTEXT_CHARS=70000
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=repopilot-sandbox:local
SANDBOX_TIMEOUT_SECONDS=120
RUNNING_IN_CONTAINER=true
# Docker Desktop exposes the mounted daemon socket with GID 0. On Linux, set
# this to: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=0

# GitHub writes are disabled unless all three values are set.
GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
GITHUB_ALLOWED_OWNERS=xsw932187210-cell
